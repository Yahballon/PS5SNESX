# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Linux/WSL build entry points require LF even on Windows.
*.sh text eol=lf
*.py text eol=lf
*.mk text eol=lf
ps5/proto/native/tooling/prospero-clang18 text eol=lf

# Declare files that will always have CRLF line endings on checkout.
*.sln text eol=crlf
*.props text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
